# 复制为 .env 后填写。.env 已被 .gitignore 排除，不要提交。
#
# 真实密钥只存在于网关这一侧；APK 里永远不出现。
DEEPSEEK_API_KEY=

# 监听端口（App 的「网关地址」要指向它）
PORT=8787

# 允许客户端使用的模型白名单。客户端传别的会被强制改回第一个。
ALLOWED_MODELS=deepseek-flash

# 签发设备令牌的口令。用 32 位以上随机串：
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
# 留空则 /v1/admin/issue 关闭（只能手工往 data/tokens.json 写哈希）。
ISSUE_SECRET=

# 每个令牌的限额
DAILY_QUOTA=50
PER_MINUTE=6

# 请求体上限（一张 1280px JPEG base64 后约 400 KB）
MAX_BODY_BYTES=8388608
